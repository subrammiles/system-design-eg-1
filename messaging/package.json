{
  "name": "messaging",
  "version": "1.0.0",
  "description": "WhatsApp-style chat backend: WebSocket gateways, ordered + idempotent message acceptance, Cassandra history, transactional outbox -> Kafka -> delivery, receipts, sync, presence, media",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gateway": "node src/gateway/server.js",
    "messaging-service": "node src/messaging-service/server.js",
    "outbox-publisher": "node src/outbox-publisher/worker.js",
    "delivery-worker": "node src/delivery-worker/worker.js",
    "notification-worker": "node src/notification-worker/worker.js",
    "init": "node scripts/init.js",
    "demo": "node scripts/demo.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "cassandra-driver": "^4.7.2",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  }
}
