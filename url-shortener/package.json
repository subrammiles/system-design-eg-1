    "create-tables": "node scripts/create-tables.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "qrcode": "^1.5.4"
