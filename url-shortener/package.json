{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL shortener (Bitly/TinyURL style) implementing the system design: URL service, redirect service, async analytics pipeline",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "url-service": "node src/url-service/server.js",
    "redirect-service": "node src/redirect-service/server.js",
